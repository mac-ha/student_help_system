# Copy this file to .env and fill in your own values.
PORT=2000
# Keep loopback unless a reverse proxy or container needs to reach the app.
HOST=127.0.0.1
# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For.
# TRUST_PROXY=1

DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/student_system

# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when NODE_ENV=production.
SESSION_SECRET=change-me-to-a-long-random-string

# Business rules (from the flowchart)
MAX_COURSES=6
REMARK_FEE=525

# Password reset email
# console = print reset links in the server log (development only)
# smtp    = real delivery using the SMTP settings below
MAIL_TRANSPORT=console
# Absolute URL students open; used to build reset links (no trailing slash).
PUBLIC_BASE_URL=http://127.0.0.1:2000
PASSWORD_RESET_MINUTES=30

# Required when MAIL_TRANSPORT=smtp
# MAIL_FROM="Student System <no-reply@your-domain>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# Used by `npm run db:seed`.
# HOD_PASSWORD is required in production before the first seed; without it the
# lecturer account is created with the demo password.
# HOD_PASSWORD=HodPass12345
# DEMO_STUDENT_PASSWORD=Student123!
# Set to 1 to seed the demo student in production (not recommended).
# SEED_DEMO_STUDENT=1
